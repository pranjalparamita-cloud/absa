# ---------------------------------------------------------------------------
# Google login (st.login) — paste the SAME block into
# Streamlit Cloud -> Manage app -> Settings -> Secrets.
# NEVER commit the real secrets.toml to GitHub. It is already in .gitignore.
# ---------------------------------------------------------------------------
[auth]
client_id = "123456789012-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
redirect_uri = "https://YOUR-APP.streamlit.app/oauth2callback"

# For local testing use:
# redirect_uri = "http://localhost:8501/oauth2callback"
# and add that URI in Google Cloud too.
